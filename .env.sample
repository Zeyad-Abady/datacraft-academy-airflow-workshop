# Copy this file to .env before first boot:
#   cp .env.sample .env
#
# On Linux, also set AIRFLOW_UID to your host user id to avoid file
# permission issues on mounted volumes:
#   echo "AIRFLOW_UID=$(id -u)" >> .env
# On macOS / Windows (Docker Desktop) the default below is fine as-is.

AIRFLOW_UID=50000

# Admin user created once by the airflow-init service.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
